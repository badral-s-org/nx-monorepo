{
  "name": "secret-manager-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "vars": {
    "ENVIRONMENT": "development",
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
      },
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-manager",
      "database_id": "ca466baa-a95e-4574-9629-822015d4d825",
      "migrations_dir": "drizzle",
      // "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
}
