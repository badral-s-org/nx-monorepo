{
  "name": "@org/secret-manager-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db-generate": "npx drizzle-kit generate --config=drizzle.config.ts",
    "db-migrate-local": "npx wrangler d1 migrations apply secret-manager --local -c wrangler.jsonc",
    "db-migrate-prod": "npx wrangler d1 migrations apply secret-manager --remote -c wrangler.jsonc"
  },
  "nx": {
    "targets": {
      "db-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx drizzle-kit generate --config=apps/secret-manager-service/drizzle.config.ts"
        }
      },
      "db-migrate-local": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx wrangler d1 migrations apply secret-manager --local -c apps/secret-manager-service/wrangler.jsonc"
        }
      },
      "db-migrate-prod": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx wrangler d1 migrations apply secret-manager --remote -c apps/secret-manager-service/wrangler.jsonc"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["production", "^production"],
        "outputs": ["{projectRoot}/dist"],
        "options": {
          "cwd": "apps/secret-manager-service",
          "command": "npx wrangler deploy --dry-run --outdir dist"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": ["typecheck"],
        "options": {
          "cwd": "apps/secret-manager-service",
          "command": "npx wrangler deploy"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/secret-manager-service",
          "command": "npx wrangler dev --var ENVIRONMENT:development"
        }
      },
      "serve-remote": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/secret-manager-service",
          "command": "npx wrangler dev --remote --var ENVIRONMENT:development"
        }
      }
    }
  },
  "dependencies": {}
}
